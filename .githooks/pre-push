#!/bin/sh
# spark pre-push gate: the slower proofs (~20 s). NOTICE-skip when a
# prerequisite is missing; never silently pass.
set -eu
cd "$(git rev-parse --show-toplevel)"
fail=0
if [ -f tests/install_test.sh ]; then
    sh tests/install_test.sh >/dev/null || { echo "pre-push: tests/install_test.sh failed"; fail=1; }
fi
if [ -f tests/get_test.sh ]; then
    sh tests/get_test.sh >/dev/null || { echo "pre-push: tests/get_test.sh failed"; fail=1; }
fi
if [ -f tests/update_test.sh ]; then
    sh tests/update_test.sh >/dev/null || { echo "pre-push: tests/update_test.sh failed"; fail=1; }
fi
if [ -f bin/spark ] && [ -f lib/spark/check.py ]; then
    python3 bin/spark check --selftest || { echo "pre-push: spark check --selftest failed"; fail=1; }
fi
[ "$fail" -eq 0 ] || { echo "pre-push: refused"; exit 1; }
