#!/bin/sh
# spark pre-commit gate: the fast half of tests/gate.sh, in seconds. The
# privacy gate over the staged change (it has no skip path), syntax, the
# cheatsheet's 80 columns, ASCII docs, shellcheck, docs_test. The full
# gate runs in CI, once per commit: `sh tests/land.sh` sends a commit
# there and lands it on main when it is green.
exec sh "$(git rev-parse --show-toplevel)/tests/gate.sh" fast
