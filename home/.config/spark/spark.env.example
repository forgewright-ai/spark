# spark runtime configuration -- optional, read from ~/.config/spark/spark.env
#
# Plain KEY=value, no shell syntax. Every key has a default; environment
# variables of the same name win over this file. Secrets never go here: the
# bearer token is a 0600 file (SPARK_API_KEY_FILE), never a value.

# Port the local server binds and clients try last.       default 8080
SPARK_PORT=8080
# Talk ONLY to this server; never consider others.         default unset
SPARK_BASE_URL=
# Try this server first, fall home silently if it is down. default: site peer
SPARK_PREFER_URL=
# Address `spark serve` binds. Default: this machine's LAN address.
# 0.0.0.0 is never chosen for you.
SPARK_SERVE_HOST=
# Directory holding llama-server. Default: ~/.local/share/spark/engine/<newest>
# on Linux, Homebrew's bin on macOS.
SPARK_ENGINE_DIR=
# Directory holding *.gguf files.           default ~/.local/share/spark/models
SPARK_MODELS_DIR=
# Which file to serve (name inside SPARK_MODELS_DIR, or an absolute path).
# Default: the newest .gguf in SPARK_MODELS_DIR.
SPARK_MODEL=
# GPU layers and context size handed to llama-server.     defaults 999, 8192
# With an ember, SPARK_CTX is the ember's context; the prompt line's model
# is fixed at 4096 (the line never needs more).
# `spark bench --tune` finds the best NGL/FLASH_ATTN/KV/THREADS for this
# machine and `spark tune apply` writes them here; edit by hand at will.
SPARK_NGL=
SPARK_CTX=
# Flash attention: auto | on | off                          default auto
SPARK_FLASH_ATTN=
# KV cache type: f16 | q8_0 | q4_0                          default f16
SPARK_KV=
# CPU threads for generation; empty lets llama-server decide
SPARK_THREADS=
# Extra llama-server flags, space separated.               default none
SPARK_EXTRA_ARGS=
# Override the memory guard (GB the model is assumed to need).
SPARK_MEM_NEEDED_GB=
# Token file (0600). default ~/.local/state/spark/api-token
SPARK_API_KEY_FILE=
# Seconds to wait for an answer.                           default 20
SPARK_TIMEOUT=
# Days of turns and threads to keep; `off` keeps none.     default 30
SPARK_HISTORY=
# Recall the facts in ~/.config/spark/memory on every answer: on | off
# (`spark memory on|off` writes this; `spark remember` adds a fact).
SPARK_MEMORY=
# Deprecated: `spark soul edit` absorbs it. Read as the soul's fallback in
# this version only; the check's soul row warns while it is still set.
SPARK_PERSONA_EXTRA=
# auto: bootstrap enables the always-on server when engine+model+token exist.
# none: never enable a service; `spark serve` by hand only.
SPARK_SERVICE=auto
# The FORGE, the served agent (`spark forge`): auto | on | off    default auto
# auto: wherever the model server is enabled. `spark forge on|off` writes this.
SPARK_FORGE=
# Address the FORGE binds. Default: this machine's LAN address; never 0.0.0.0.
SPARK_FORGE_HOST=
# Port the FORGE binds; its clients and browsers use it.  default 8081
SPARK_FORGE_PORT=
# Its token file (0600), never the api-token. default ~/.local/state/spark/forge-token
SPARK_FORGE_TOKEN_FILE=
