# spark runtime configuration -- optional, read from
# ~/.config/spark/spark.env
#
# Plain KEY=value, no shell syntax. Every key has a default. An
# environment variable of the same name wins over this file. Secrets
# never go here: the bearer token is a 0600 file (SPARK_API_KEY_FILE),
# never a value.

# The port the engine binds and clients try last.         default 8080
SPARK_PORT=8080
# Talk to this server only and never consider others.     default unset
SPARK_BASE_URL=
# Try this server first, and fall home silently if it is down.
# Default: the other machine, SITE_PEER_AI_URL.
SPARK_PREFER_URL=
# The address `spark serve` binds. Default: this machine's LAN address.
# 0.0.0.0 is never chosen for you.
SPARK_SERVE_HOST=
# The directory holding llama-server.
# Default: ~/.local/share/spark/engine/<newest>
SPARK_ENGINE_DIR=
# The directory holding *.gguf files.
# Default: ~/.local/share/spark/models
SPARK_MODELS_DIR=
# The file to serve: a name inside SPARK_MODELS_DIR, or an absolute
# path.
# Default: the newest .gguf in SPARK_MODELS_DIR.
SPARK_MODEL=
# GPU layers and context size for llama-server.       defaults 999, 8192
# With a chat model, SPARK_CTX is that model's context. The prompt
# line's model is fixed at 4096, because the line never needs more.
# `spark bench tune` finds the best SPARK_NGL, SPARK_FLASH_ATTN,
# SPARK_KV and SPARK_THREADS for this machine, and `spark bench tune
# apply` writes them here. Edit by hand at will.
SPARK_NGL=
SPARK_CTX=
# Flash attention: auto | on | off                          default auto
SPARK_FLASH_ATTN=
# KV cache type: f16 | bf16 | q8_0 | q4_0                   default f16
SPARK_KV=
# CPU threads for generation. Empty lets llama-server decide.
SPARK_THREADS=
# Extra llama-server flags, space separated.               default none
SPARK_EXTRA_ARGS=
# Override the memory guard: the GB the model is assumed to need.
SPARK_MEM_NEEDED_GB=
# The token file (0600).
# Default: ~/.local/state/spark/api-token
SPARK_API_KEY_FILE=
# Seconds to wait for an answer.                           default 20
SPARK_TIMEOUT=
# The reply cap of chat, explain and a question, in tokens. default 1200
SPARK_MAX_TOKENS=
# The pace of a reply at a terminal: off (as it comes), auto (the
# measured threshold: `spark stats`), or N a second.       default off
SPARK_REVEAL=
# SPARK_REVEAL_CPS=  the reveal pace in characters per second, 5..200,
#                    default 30
# Days of turns and threads to keep. off keeps none.       default 30
SPARK_HISTORY=
# Recall the facts in your memory on every answer: on | off.
# `spark memory on|off` writes this, and `spark memory add` adds a
# fact.
SPARK_MEMORY=
# Older: `spark soul edit` replaces it. It is still read as the soul's
# fallback, and the check's soul row warns while it is set.
SPARK_PERSONA_EXTRA=
# auto: bootstrap enables the engine's unit, up from boot, when the
# engine, a model and the token exist. none: never enable a service,
# and `spark serve` runs by hand only.
SPARK_SERVICE=auto
# The page's server (`spark forge`): auto | on | off        default auto
# auto: wherever the engine is enabled. `spark forge on|off` writes
# this.
SPARK_FORGE=
# The address the page's server binds. Default: this machine's LAN
# address, never 0.0.0.0.
SPARK_FORGE_HOST=
# The port the page's server binds. Its clients and browsers use it.
#                                                          default 8081
SPARK_FORGE_PORT=
# Its token file (0600), never the api-token.
# Default: ~/.local/state/spark/forge-token
SPARK_FORGE_TOKEN_FILE=
