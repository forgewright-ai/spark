# spark site configuration -- copied by bootstrap.sh to ~/.config/spark/site.env
#
# Plain KEY=value, one per line, no quotes needed, no shell syntax allowed:
# a line that is not `KEY=value` is refused by every reader. Every key is
# optional; a missing key takes the default shown. This file is yours and is
# never tracked -- it is where your name, your network and your choices live,
# so that the repository itself never has to.

# --- identity -----------------------------------------------------------
# Display name of this workstation: status line, check signature, the AI's
# "on <name>". Default: the short hostname.
SITE_NAME=
# Set the OS hostname to SITE_NAME as well (needs sudo; touches mDNS). no|yes
SITE_SET_HOSTNAME=no
# Your display name for the prompt and the AI persona. Default: your login.
SITE_USER=

# --- network ------------------------------------------------------------
# Another machine's FORGE (spark forge --print-client there), or its raw
# `spark serve` URL; used before the local server when it answers. With
# SITE_AI_MODEL=none this machine is a client: nothing runs here (spark
# client URL sets both). Leave empty for none.  e.g. http://studio.local:8081
SITE_PEER_AI_URL=
# An ssh target `spark check` should be able to reach (key auth). Optional.
SITE_PEER_SSH=

# --- choices ------------------------------------------------------------
# none, or a palette from themes/ (`spark theme` lists them; gruvbox-dark
# is the one that matches the logo). `none` leaves your terminal and tmux
# at their own colours. Later: `spark theme NAME`.
SITE_THEME=none
# auto | none | a name from the table (`spark model list`). auto reads only
# the rows tested on the line under Apache-2.0 or MIT: the smallest such
# row when an ember then fits beside it, else the largest that fits the
# SITE_AI_BUDGET percent (default 60) of RAM plus GPU memory and stays
# usable on this build -- a file of at most 3 GB on cpu, 6 GB on vulkan,
# 20 GB on metal (about 8 tok/s or better). A name is taken as it is,
# from models.env or ~/.config/spark/models.env (yours); a row under
# another license asks first.
SITE_AI_MODEL=auto
# none | auto | a name from the table: a second, larger model for
# conversations; spark stays the small one at the prompt. none: one model
# does both; auto reads the tested open-license rows: the largest usable
# one that fits beside it. Later: `spark ember NAME`.
SITE_EMBER_MODEL=none
# 10..95: percent of RAM+GPU memory `auto` may use for a model, alone or
# beside an ember. Later: `spark model budget N`.
SITE_AI_BUDGET=60
# Linux engine build: auto | cpu | vulkan   (ignored on macOS: Metal).
# auto: vulkan when a GPU reports its memory in /sys/class/drm, else cpu.
SITE_AI_BUILD=auto

# --- the terminal itself (root on Linux, sudo once) ---------------------
# Font face and size. Linux: the text console -- `spark font list` shows
# the faces and sizes this box has (e.g. Terminus 16x32; 8x16 is small on
# a 1080p screen); empty leaves the console alone. macOS: the Terminal.app
# profile spark generates (a font's PostScript name, default
# JetBrainsMonoNFM-Regular; size in points).
SITE_FONT_FACE=
SITE_FONT_SIZE=
# Linux only. Quiet login: no distro notice, no kernel line before the
# greeting. Quiet boot: a silent boot -- GRUB's menu hidden, the kernel
# line quiet, systemd silent, via one drop-in in /etc/default/grub.d
# (hold Shift at boot for the menu); the drop-in is the Debian family's,
# Arch's GRUB is left alone. no|yes
# Later: `spark quiet login|boot on`.
SITE_QUIET_LOGIN=no
SITE_QUIET_BOOT=no
# Both OSes. Quiet start: spark's own noise -- no login banner, `spark
# serve` and `spark forge` answer with one line, bare `spark` with one
# line (`spark status` keeps the full report). Later: `spark quiet start
# on`. no|yes
SITE_QUIET_START=no
# Both OSes. yes: spark plays no sound (the `audio` check row says which
# player it would use). Later: `spark quiet audio on`. no|yes
SITE_QUIET_AUDIO=no
# yes: keep the FORGE up from boot and never sleep -- a box that is the brain
# (Linux: linger, sleep targets masked, lid ignored; macOS: LaunchDaemons in
# system/, pmset never sleeps, wake on LAN). Applied by bootstrap;
# spark headless on|off sets it. no|yes
SITE_HEADLESS=no

# Share this box's one engine with its other OS users: a `spark` OS group
# reads a 0640 copy of the api-token, so a group member's spark (a client
# of this box) answers from the shared llama-server -- their own soul and
# memory, one model loaded once. Linux only in this version. Applied by
# bootstrap; spark share on|off sets it. no|yes
SITE_SHARE=no
