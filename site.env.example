# spark site configuration -- copied by bootstrap.sh to ~/.config/spark/site.env
#
# Plain KEY=value, one per line, no quotes needed, no shell syntax. Every
# reader refuses a line that is not `KEY=value`. Every key is optional; a
# missing key takes the default shown. This file is yours and is never
# tracked: your name, your network and your choices live here, so the
# repository never has to hold them.

# --- identity -----------------------------------------------------------
# The display name of this machine: the status line, the check signature,
# the model's "on <name>". Default: the short hostname.
SITE_NAME=
# Set the OS hostname to SITE_NAME as well (needs sudo; touches mDNS). no|yes
SITE_SET_HOSTNAME=no
# Your display name for the prompt line and the model. Default: your login.
SITE_USER=

# --- network ------------------------------------------------------------
# Another machine's page server (`spark forge --print-client` there), or
# its raw `spark serve` URL. It is used before the local server when it
# answers. With SITE_AI_MODEL=none this machine is a client and nothing
# runs here (`spark client URL` sets both). Leave empty for none.
# Example: http://studio.local:8081
SITE_PEER_AI_URL=
# An ssh target `spark check` should be able to reach, with key auth.
# Optional.
SITE_PEER_SSH=

# --- choices ------------------------------------------------------------
# none, or a palette from themes/ (`spark theme` lists them; gruvbox-dark
# matches the logo). none leaves your terminal at its own colours.
# Later: `spark theme NAME`.
SITE_THEME=none
# auto | none | a name from the table (`spark model list`). auto reads only
# the rows tested on the prompt line under Apache-2.0 or MIT. It takes the
# smallest such row when a chat model then fits beside it. Otherwise it
# takes the largest row that fits SITE_AI_BUDGET percent (default 60) of
# RAM plus GPU memory and stays usable on this build. Usable means a file
# of at most 3 GB on cpu, 6 GB on vulkan and 20 GB on metal, about 8
# tokens a second or better. A name is taken as it is, from models.env or
# ~/.config/spark/models.env (yours). A row under another license asks
# first.
SITE_AI_MODEL=auto
# none | auto | a name from the table: a second, larger model for
# conversations, while spark stays the small one at the prompt line.
# none: one model does both. auto reads the tested open-license rows and
# takes the largest usable one that fits beside the first.
SITE_EMBER_MODEL=none
# 10..95: the percent of RAM plus GPU memory `auto` may use for a model,
# alone or beside the chat model. Later: `spark model budget N`.
SITE_AI_BUDGET=60
# The Linux engine build: auto | cpu | vulkan. Ignored on macOS (Metal).
# auto: vulkan when a GPU reports its memory in /sys/class/drm, else cpu.
SITE_AI_BUILD=auto

# --- the terminal itself (root on Linux, sudo once) ---------------------
# Font face and size. Linux: the text console. `spark font list` shows the
# faces and sizes this machine has. Terminus 16x32 is one; 8x16 is small
# on a 1080p screen. Empty leaves the console alone. macOS: the
# Terminal.app profile spark generates, a font's PostScript name (default
# Menlo-Regular) and a size in points.
SITE_FONT_FACE=
SITE_FONT_SIZE=
# Linux only. Quiet login: no distro notice and no kernel line before the
# greeting. Quiet boot: a silent boot, the boot menu hidden, the kernel
# line quiet, systemd silent. On the Debian family it is one drop-in in
# /etc/default/grub.d (hold Shift at boot for the menu). On Arch a UKI
# takes an /etc/cmdline.d drop-in; without a UKI the verb refuses. no|yes
# Later: `spark quiet login|boot on`.
SITE_QUIET_LOGIN=no
SITE_QUIET_BOOT=no
# Both OSes. Quiet start: spark's own noise off. No login banner, and
# `spark serve`, `spark forge` and bare `spark` answer with one line
# (`spark status` keeps the full report). Later: `spark quiet start on`.
# no|yes
SITE_QUIET_START=no
# Both OSes. yes: spark plays no sound. The `audio` check row says which
# player it would use. Later: `spark quiet audio on`. no|yes
SITE_QUIET_AUDIO=no
# yes: keep the page's server up from boot and never sleep, for a machine
# that other machines answer from. Linux: linger, sleep targets masked,
# the lid ignored. macOS: LaunchDaemons in system/, pmset never sleeps,
# wake on LAN. Applied by bootstrap; `spark headless on|off` sets it.
# no|yes
SITE_HEADLESS=no

# Share this machine's one engine with its other OS users. A `spark` OS
# group reads a 0640 copy of the api-token, so a group member's spark (a
# client of this machine) answers from the shared llama-server. They keep
# their own soul and memory, and one model is loaded once. Linux only in
# this version. Applied by bootstrap; `spark share on|off` sets it. no|yes
SITE_SHARE=no
