# spark models.env -- the models spark can serve, one list. Every row:
#   MODEL_<NAME>="<file> <url> <bytes> <sha256> <ram_gb>"
#   MODEL_<NAME>_LICENSE="<name> <url>"      required
#   MODEL_<NAME>_TESTED="line"               only when proven on the line:
#                                            spark line answered it with
#                                            valid JSON (CLAUDE.md's rule)
#   MODEL_<NAME>_NOTE="..."                  optional, one line
#
# The order is the priority. SITE_AI_MODEL=auto serves the prompt line
# from the first tested row, in this order, that fits the budget and the
# speed cap; SITE_EMBER_MODEL=auto takes the largest tested row that fits
# beside it. Only tested rows under Apache-2.0 or MIT are auto's; every
# other row is yours by name (spark model NAME), and a row under another
# license prints it and asks before the download. ./bootstrap.sh --list-models shows the table with a RAM
# verdict and marks the picks (* spark, + ember). ram_gb = file size x 1.1
# + 1.5, rounded up (weights plus context and runtime). Names: MODEL_<NAME>,
# shown lower-case with dashes. Your own rows go in ~/.config/spark/models.env
# (spark model add URL --license writes one).
#
# Sizes and sha256 come from Hugging Face's file metadata: on the redirect
# https://huggingface.co/<repo>/resolve/main/<file>?download=true answers
# with, x-linked-size and x-linked-etag. bootstrap.sh verifies the sha256
# before a file is kept. All Q4_K_M. A row is a pull request.

# The prompt line's ladder, measured on the box 2026-10-01 (tests/
# line_audition.py, tests/audition.py, llama-bench): auto takes the first
# that fits. Gemma 4 (Google) and Qwen3/Qwen3.5 (Alibaba), Apache-2.0
MODEL_GEMMA4_26B_A4B="google_gemma-4-26B-A4B-it-Q4_K_M.gguf https://huggingface.co/bartowski/google_gemma-4-26B-A4B-it-GGUF/resolve/main/google_gemma-4-26B-A4B-it-Q4_K_M.gguf 17035039872 a07f72221e8e3f77455ab0d7f7652d01a9f63c262b954aa6932a53275a0e895a 19"
MODEL_GEMMA4_26B_A4B_LICENSE="Apache-2.0 https://huggingface.co/google/gemma-4-26B-A4B-it"
MODEL_GEMMA4_26B_A4B_TESTED="line"
MODEL_GEMMA4_26B_A4B_GROUND="24/30 2026-10-01"
MODEL_GEMMA4_26B_A4B_NOTE="the best here, and as fast as E4B: 4B of its 26B work per token"
MODEL_GEMMA4_E4B="google_gemma-4-E4B-it-Q4_K_M.gguf https://huggingface.co/bartowski/google_gemma-4-E4B-it-GGUF/resolve/main/google_gemma-4-E4B-it-Q4_K_M.gguf 5405170144 d35a3aa7a6d47de237fd488bb6f7f3efd62908d828f85a63da0ee93acdbefe9f 8"
