#!/usr/bin/env python3
# spark -- your own AI, on your own machine, at no cost
#
#   spark chat                 a conversation; spark @FILE words asks about a file
#   spark <words>              ask; a streamed answer
#   spark do <words>           a task, one confirmed command at a time
#   ? how big is this dir?     at the prompt: the answer lands in your line
#   cmd 2>&1 | explain         what went wrong (explain is a symlink to spark)
#   spark serve [on|off]       the local model server
#   spark check                is this machine still what its repo says?
#   spark bar                  the tmux status line
#
# Python 3.9+, stdlib only. The package lives in lib/spark/ beside the real
# location of this file; ~/.local/bin/spark is a symlink into the repo.

import os
import signal
import sys

# `spark ... | head` must end quietly: default SIGPIPE, not a traceback.
signal.signal(signal.SIGPIPE, signal.SIG_DFL)

_HERE = os.path.dirname(os.path.realpath(__file__))
_LIB = os.path.join(os.path.dirname(_HERE), "lib")
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from spark import MARK, page, say  # noqa: E402

USAGE_HEAD = """%s -- your own AI, on your own machine, at no cost

spark
 spark                        status: brain, widget, server, soul, memory, last
 spark off | on               silence / restore the widget, every pane at once
 spark soul [edit|reset]      who it is: ~/.config/spark/soul
 spark memory add <words>     a fact it keeps; memory forget N; memory
 spark ver                    about, version, credits
 spark chat [words]           a conversation; /help lists its verbs, Ctrl-D ends
 spark [@FILE] <words>        ask about anything, or a file; a streamed answer
 spark do <words>             a task, one command at a time; you confirm each
 spark edit [?] [words]       the text on stdin: words rewrite it, ? asks,
                              --at N completes; an editor's client (-h)
 spark ask < FILE             the questions that text does not answer: at
                              most three, every line one question (-h)
 try:
 ? words or words? ENTER      the command lands in your line, hint above
 ?? words ENTER               follow up on the last answer (same thread)
 Esc s                        ask about the line you are on, no ? needed
 Esc s on an empty line       the failed command piped to explain; again
                              proposes the fix; a 127 offers the install line
 cmd 2>&1 | explain           what went wrong, and the fix
 spark <TAB>                  the verbs, then each verb's words -- offline

the FORGE: server/client
 spark model [NAME|auto|none] the served model: download, restart (-h: more)
 spark model list             the table; -h: budget N, add URL, verify, rm NAME
 spark serve [on|off]         one LAN address, token required (-h: --force)
 spark ember [NAME|auto|none] a second model for conversations; ember list
 spark forge --print-url      the login URL and token; --print-client for a peer
 spark user [add NAME]        the named users, each with sealed threads (-h)
 spark forge [on|off]         the FORGE on the LAN: the API and the page
 spark headless [on|off]      the FORGE up from boot, never asleep (a brain)
 spark client [URL|off]       answer from another machine's FORGE; none here
""" % MARK

USAGE_MACHINE = """the machine
 spark setup                  the guided first run: name, user, model (-h)
 spark check                  drift report; exit 0 = every promise kept (-h)
 spark update [--dry-run]     the newest tag, or main on a developer clone
 spark uninstall [--purge]    remove spark from this machine: shows, asks yes
"""

USAGE_INTERFACE = """the interface
 spark theme [NAME|list|show] the palettes, and yours; show = its colours
 spark quiet [SUB on|off]     start (banner), login (motd), boot (GRUB), audio
 spark font [FACE SIZE|list]  the console font (Linux) / Terminal.app's
"""

USAGE_TAIL = """less often used
 spark                        last, history [clear], stats [--week], brain,
                              bench [tune [show|apply]] -- each has -h

beside the core
 APPS.md                      editors and tools that speak to spark
 SHELL.md                     spark's own shell for a machine that is
                              only an AI box (spark shell, spark bar)

version %s
"""


def usage():
    """The help. It reads the same whatever the shell layer is doing: the
    two verbs behind that gate live in SHELL.md now, and theme, quiet and
    font are core. The version is formatted here, not at import: nothing on
    the `spark line` path may call git, and version() does, on a cache miss."""
    from spark import version
    tail = USAGE_TAIL % version.version()
    return USAGE_HEAD + "\n" + USAGE_MACHINE + "\n" + USAGE_INTERFACE + "\n" + tail


def main(argv):
    sub = argv[0] if argv else ""
    rest = argv[1:]
    if sub in ("-h", "--help", "help"):
        page(usage().rstrip())
        return 0
    spec = VERBS.get(sub)
    if spec:
        import importlib
        mod = importlib.import_module("spark." + spec[0])
        fn = getattr(mod, spec[1])
        return fn(sub, rest) if spec[2] else fn(rest)
    from spark import cli
    if len(argv) == 1 and " " not in sub and not sub.endswith("?") and not sub.startswith("@") and sub not in cli.COMMANDS:
        # one word that is not a command: a slip, not a question -- questions
        # are several words (quoted or not), end with ?, or name a file (@FILE)
        return misplaced(sub)
    if len(argv) > 1 and sub not in cli.COMMANDS and "?" not in sub and not sub.startswith("@"):
        # a near-miss of a verb with arguments is a typo, not a question:
        # `spark quite start on` must not become a conversation
        near = near_verb(sub, cli)
        if near:
            say("spark: no command named %s -- try: spark %s   (a question ends with ?)" % (sub, near))
            return 2
    return cli.main(argv)


# The verbs this file dispatches: verb -> (module under lib/spark, entry,
# whether the entry takes the verb too). The module is imported only when
# its verb runs -- `spark line` must stay cheap. Everything else is
# cli.COMMANDS, or a question.
VERBS = {"setup": ("setup", "main", False), "check": ("check", "main", False),
         "ask": ("ask", "cmd_ask", False),
         "update": ("update", "cmd_update", False), "bar": ("bar", "main", False),
         "theme": ("theme", "main", False), "bench": ("bench", "main", True),
         "stats": ("stats", "main", False),
         "shell": ("site", "main", True), "font": ("site", "main", True), "quiet": ("site", "main", True),
         "model": ("site", "main", True), "headless": ("site", "main", True), "ember": ("site", "main", True),
         "client": ("site", "main", True),
         "serve": ("serve", "main", True),
         "forge": ("forgeserve", "main", False), "user": ("users", "main", False),
         "uninstall": ("uninstall", "main", False)}


def near_verb(word, cli):
    import difflib
    hits = difflib.get_close_matches(word, ("help",) + tuple(VERBS) + tuple(cli.COMMANDS), n=1, cutoff=0.8)
    return hits[0] if hits else None


def misplaced(word):
    from spark import REPO, cli, config
    if word in config.theme_names(REPO) or word == "none":
        say("spark: %s is a palette -- spark theme %s" % (word, word))
    elif word in {r[0] for r in config.model_tables()} or word == "auto":
        say("spark: %s is a model -- spark model %s" % (word, word))
    else:
        near = near_verb(word, cli)
        hint = "try: spark %s" % near if near else "spark help lists them"
        say("spark: no command named %s -- %s; a question is several words, or ends with ?" % (word, hint))
    return 2


if __name__ == "__main__":
    argv = sys.argv[1:]
    # `explain` on PATH is a symlink to this file: the name picks the mode.
    if os.path.basename(sys.argv[0]) == "explain":
        argv = ["explain"] + argv
    try:
        sys.exit(main(argv))
    except KeyboardInterrupt:
        sys.exit(130)
