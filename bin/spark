#!/usr/bin/env python3
# spark -- your own AI, on a machine you own: no account, no cloud, nothing leaves
#
#   spark chat                 a conversation; spark @FILE words asks about a file
#   spark <words>              ask; a streamed answer
#   spark do <words>           a task, one confirmed command at a time
#   ? how big is this dir?     at the prompt: the answer lands in your line
#   cmd 2>&1 | explain         what went wrong (explain is a symlink to spark)
#   spark serve [on|off]       the engine: one LAN address, token required
#   spark check                the machine row by row; exit 0 = every row ok
#   spark bar                  the machine's one-line status
#
# Python 3.9+, stdlib only. The package lives in lib/spark/ beside the real
# location of this file; ~/.local/bin/spark is a symlink into the repo.

import os
import signal
import sys

# `spark ... | head` must end quietly: default SIGPIPE, not a traceback.
signal.signal(signal.SIGPIPE, signal.SIG_DFL)

_HERE = os.path.dirname(os.path.realpath(__file__))
_LIB = os.path.join(os.path.dirname(_HERE), "lib")
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from spark import MARK, page, say  # noqa: E402

USAGE_HEAD = """%s -- your own AI, on a machine you own: no account, no cloud, nothing leaves

spark
 spark                        status: the model, the prompt line, the server,
                              soul, memory, last answer
 spark off | on               silence / restore the prompt line in every pane
 spark soul [edit|reset]      who it is: ~/.config/spark/soul
 spark memory add <words>     a fact it keeps; memory forget N; memory
 spark ver [--sbom]           about, version, credits; or what it depends on
 spark chat [words]           a conversation; /help lists its verbs, Ctrl-D ends
 spark [@FILE] <words>        ask about anything, or a file; a streamed answer
 spark do [--sandbox] <words> a task, one command at a time; you confirm each,
                              or, sandboxed, the changes once at the end
 spark do --review [ID]       sandboxed runs waiting: the diff, then yes
 spark edit [?] [words]       the text on stdin: words rewrite it, ? asks,
                              --at N completes; the verb a spark app calls (-h)
 spark ask < FILE             the questions that text does not answer: at
                              most 3, every line one question (-h)
 spark read <words> < FILE    what a source says about your question, every
                              line quoting it; 16 kB a part (-h)
 spark drill < FILE           the source becomes questions it answers; you
                              try each, --name keeps a schedule (-h)
 spark watch <words> < STREAM a live stream, silent until a line matches,
                              then one line quoting it (-h)
 spark reveal [CPS]           stdin at a reader's pace, letter by letter at
                              a terminal; an exact copy anywhere else (-h);
                              chat/explain/words: --reveal [N|auto|off]
 try:
 ? words or words? Enter      the command lands in your line, hint above
 ?? words Enter               follow up on the last answer (same thread)
 Esc s                        ask about the line you are on, no ? needed
 Esc s on an empty line       the failed command piped to explain; again
                              proposes the fix; a 127 offers the install line
 Esc r                        describe a past command; it lands in your line
                              (Esc r again cycles); Ctrl-R stays the shell's
 cmd 2>&1 | explain           what went wrong, and the fix
 spark <TAB>                  the verbs, then each verb's words -- offline

the model and the page
 spark model [NAME|auto|none] the served model: download, restart (-h: more)
 spark model list             the table; -h: budget N, add URL, verify, rm NAME
 spark serve [on|off]         one LAN address, token required (-h: --force)
 spark ember [NAME|auto|none] the chat model, a second one; ember list
 spark forge --print-url      the login URL; at a terminal a QR and the token
 spark user [add NAME]        the named users, each with sealed threads; add
                              shows the token and its QR once (-h)
 spark forge [on|off]         the page's server on the LAN: the API and the page
 spark forge audit [N]        every admin action, sealed: runs, users, tokens
 spark headless [on|off]      the page's server up from boot, never asleep
 spark share [on|off]         one engine for every OS user here (a spark
                              group); each keeps their own soul and memory
 spark client [URL|off]       a client of another machine's server; none here
""" % MARK

USAGE_MACHINE = """the machine
 spark setup                  the guided first run: name, user, model (-h)
 spark check                  the machine row by row; exit 0 when no row fails
 spark update [--dry-run]     the newest release tag; main on a developer clone
 spark uninstall [--purge]    remove spark from this machine: shows, asks yes
"""

USAGE_INTERFACE = """the interface
 spark theme [NAME|list|show] the palettes, and yours; show = its colours
 spark quiet [SUB on|off]     start (banner), login (motd), boot (menu), audio
 spark font [FACE SIZE|list]  the console font (Linux) / Terminal.app's
 spark bar [line]             the machine's one-line status
"""

USAGE_TAIL = """less often used
 spark                        last, history [clear], stats [--week|--sends],
                              brain, bench [tune [show|apply]] -- each has -h

docs/
 docs/INSTALL.md              every step and every key; docs/CHEATSHEET.txt
 docs/TOUR.md                 a first hour: 12 small things to try
 docs/APPS.md                 editors and tools that speak to spark

version %s
"""


def usage():
    """The help: theme, quiet, font and the bar line are the interface.
    The version is formatted here, not at import: nothing on the `spark
    line` path may call git, and version() does, on a cache miss."""
    from spark import version
    tail = USAGE_TAIL % version.version()
    return USAGE_HEAD + "\n" + USAGE_MACHINE + "\n" + USAGE_INTERFACE + "\n" + tail


def main(argv):
    sub = argv[0] if argv else ""
    rest = argv[1:]
    if sub in ("-h", "--help", "help"):
        page(usage().rstrip())
        return 0
    spec = VERBS.get(sub)
    if spec:
        import importlib
        mod = importlib.import_module("spark." + spec[0])
        fn = getattr(mod, spec[1])
        return fn(sub, rest) if spec[2] else fn(rest)
    if sub in KNOWN_GONE:
        # a verb that once existed, or a word people reach for: refused
        # whatever follows -- `spark shell on` is not a question
        say("spark: no command named %s -- spark help lists them" % sub)
        return 2
    if len(argv) == 1 and " " not in sub and not sub.endswith("?") and not sub.startswith("@"):
        # one word that is not a command: a slip, not a question -- questions
        # are several words (quoted or not), end with ?, or name a file (@FILE)
        return misplaced(sub)
    if len(argv) > 1 and "?" not in sub and not sub.startswith("@"):
        # a near-miss of a verb with arguments is a typo, not a question:
        # `spark quite start on` must not become a conversation
        near = near_verb(sub)
        if near:
            say("spark: no command named %s -- try: spark %s   (a question ends with ?)" % (sub, near))
            return 2
    from spark import cli
    return cli.main(argv)


# The one dispatch table: verb -> (module under lib/spark, entry, whether
# the entry takes the verb too). The module is imported only when its
# verb runs -- `spark line` must stay cheap. Anything else is a question
# (cli.main).
VERBS = {"setup": ("setup", "main", False), "check": ("check", "main", False),
         "ask": ("ask", "cmd_ask", False), "edit": ("edit", "cmd_edit", False),
         "read": ("read", "cmd_read", False), "drill": ("drill", "cmd_drill", False),
         "watch": ("watch", "cmd_watch", False),
         "reveal": ("reveal", "cmd_reveal", False),
         "update": ("update", "cmd_update", False), "bar": ("bar", "main", False),
         "theme": ("theme", "main", False), "bench": ("bench", "main", True),
         "stats": ("stats", "main", False),
         "font": ("site", "cmd_font", False), "quiet": ("site", "cmd_quiet", False),
         "headless": ("site", "cmd_headless", False), "client": ("site", "cmd_client", False),
         "share": ("site", "cmd_share", False),
         "model": ("model", "cmd_model", False), "ember": ("model", "cmd_ember", False),
         "serve": ("serve", "main", True),
         "forge": ("forgeserve", "main", False), "user": ("users", "main", False),
         "uninstall": ("uninstall", "main", False),
         "line": ("cli", "cmd_line", False), "last": ("cli", "cmd_last", False),
         "status": ("cli", "cmd_status", False), "brain": ("cli", "cmd_brain", False),
         "explain": ("cli", "cmd_explain", False), "off": ("cli", "cmd_off", False),
         "on": ("cli", "cmd_on", False), "history": ("cli", "cmd_history", False),
         "soul": ("cli", "cmd_soul", False), "memory": ("cli", "cmd_memory", False),
         "chat": ("cli", "cmd_chat", False), "do": ("cli", "cmd_do", False),
         "recall": ("cli", "cmd_recall", False), "lua": ("cli", "cmd_lua", False),
         "ver": ("cli", "cmd_ver", False), "version": ("cli", "cmd_ver", False),
         "--version": ("cli", "cmd_ver", False)}

# Words that were verbs once, or that a new user reaches for: never a
# question, whatever follows. `spark ask` is a verb (contract 12) and is
# dispatched above, so it is not here.
KNOWN_GONE = ("shell", "stop", "remember", "talk")


def near_verb(word):
    import difflib
    hits = difflib.get_close_matches(word, ("help",) + tuple(VERBS), n=1, cutoff=0.8)
    return hits[0] if hits else None


def misplaced(word):
    from spark import REPO, config
    if word in config.theme_names(REPO) or word == "none":
        say("spark: %s is a palette -- spark theme %s" % (word, word))
    elif word in {r[0] for r in config.model_tables()} or word == "auto":
        say("spark: %s is a model -- spark model %s" % (word, word))
    else:
        near = near_verb(word)
        hint = "try: spark %s" % near if near else "spark help lists them"
        say("spark: no command named %s -- %s; a question is several words, or ends with ?" % (word, hint))
    return 2


if __name__ == "__main__":
    argv = sys.argv[1:]
    # `explain` on PATH is a symlink to this file: the name picks the mode.
    if os.path.basename(sys.argv[0]) == "explain":
        argv = ["explain"] + argv
    try:
        sys.exit(main(argv))
    except KeyboardInterrupt:
        sys.exit(130)
