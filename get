#!/bin/sh
# spark get -- the one-liner: clone spark to ~/.spark, then spark setup.
#
#   curl -fsSL https://github.com/forgewright-ai/spark/releases/latest/download/get | sh
#   sh get [--clone-only]          the same from a file you read first
#
# SPARK_HOME is where the clone goes (default ~/.spark); SPARK_URL where it
# comes from (default the public https URL); SPARK_REF checks out a ref
# right after a fresh clone (developers: SPARK_REF=main) -- with no ref, a
# fresh clone detaches at the newest v* tag on origin, or stays on the
# default branch when there is none. An existing spark clone: fetch tags,
# then pull --ff-only on a branch, or move to the newest tag when detached
# -- so this line is also the updater (`spark update` is the same, from
# inside a checkout). A tag is a release only when a known key signed it
# (git >= 2.34 reads the ssh signature, ssh-keygen checks it) and the
# name inside the tag object is the tag's own name; an update also moves
# forward only. A fresh clone is checked against the release key below,
# in this file, never against the allowed-signers the clone brought; an
# existing clone against its own allowed-signers, the tree it already
# trusts. The newest tag that passes is taken, and the newer ones passed
# over are named in one line with the reason. Any other non-empty
# directory is refused. It never runs sudo: the package manager is spark
# setup's, asked once. The whole body is one function called on the last
# line, so a download cut short runs nothing.
set -eu

# the release key(s): exactly the lines of allowed-signers at this
# release, byte for byte (tests/docs_test.py holds the two equal, so a
# key rotation changes both in one commit)
SIGNERS='spark-release namespaces="git" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPxyUnv3kjSao3vcdPBrkrKvt5HkEc1UPJmUHO3kuzRo'

notice() { printf 'NOTICE: %s\n' "$*"; }
refuse() { printf 'spark get: %s\n' "$*" >&2; exit 1; }
# why DIR TAG SIGNERS [forward]: nothing when TAG is a release to land on,
# else one short reason. The signature covers the tag object, not the ref
# naming it: an old signed release pushed again as v99.0 verifies, so the
# object's own `tag` header must say TAG; with `forward` (an update) TAG
# must be at or ahead of HEAD
why() {
    [ "$(git -C "$1" cat-file -t "refs/tags/$2" 2>/dev/null)" = tag ] || { echo "not signed by a known key"; return 0; }
    n=$(git -C "$1" cat-file tag "refs/tags/$2" 2>/dev/null | sed -n '/^$/q; s/^tag //p')
    [ "$n" = "$2" ] || { echo "named $(printf '%s' "${n:-nothing}" | tr -c 'A-Za-z0-9._+-' '?' | cut -c1-40) inside"; return 0; }
    if [ -n "${4:-}" ] && ! git -C "$1" merge-base --is-ancestor HEAD "$2" 2>/dev/null; then
        echo "behind this checkout"; return 0
    fi
    git -C "$1" -c "gpg.ssh.allowedSignersFile=$3" verify-tag "$2" >/dev/null 2>&1 || echo "not signed by a known key"
}
# pick DIR SIGNERS [forward]: $found is the newest v* tag that passes
# (empty: none), $skipped the newer ones passed over, three named at most
pick() {
    found='' skipped='' n_skipped=0
    for t in $(git -C "$1" tag -l 'v[0-9]*' --sort=-v:refname); do
        w=$(why "$1" "$t" "$2" "${3:-}")
        if [ -z "$w" ]; then found=$t; break; fi
        n_skipped=$((n_skipped + 1))
        [ "$n_skipped" -gt 3 ] || skipped="${skipped:+$skipped, }$t ($w)"
    done
    [ "$n_skipped" -le 3 ] || skipped="$skipped and $((n_skipped - 3)) more"
}

main() {
    dir=${SPARK_HOME:-$HOME/.spark}
    url=${SPARK_URL:-https://github.com/forgewright-ai/spark.git}
    ref=${SPARK_REF:-}
    clone_only=0
    for a in "$@"; do
        case $a in
            --clone-only) clone_only=1 ;;
            *) refuse "no option $a (only --clone-only)" ;;
        esac
    done
    case $dir in "$HOME"/*) show="~${dir#"$HOME"}" ;; *) show=$dir ;; esac
    printf 'spark get -- installs spark in %s (no sudo)\n' "$show"
    # the notice, before anything changes: lib/spark/setup.py's NOTICE,
    # byte for byte (tests/smoke.py holds the two equal); spark setup
    # asks the one question
    printf '%s\n' \
        '* spark is MIT licensed and comes with no warranty -- see LICENSE' \
        '* a model can be wrong -- read a command before you run it' \
        '* what you run or accept is your own risk'

    os=$(uname -s)
    case $os in
        Darwin)
            # before git: without the command line tools, `git` itself pops
            # Apple's install dialog
            xcode-select -p >/dev/null 2>&1 \
                || refuse "the command line tools are missing -- xcode-select --install, then run this again"
            ;;
        Linux)
            # the family by its package manager: the fix line below names it
            if command -v apt-get >/dev/null 2>&1; then fix="sudo apt-get install -y git openssh-client python3 curl"
            elif command -v pacman >/dev/null 2>&1; then fix="sudo pacman -S --needed git openssh python curl"
            elif command -v xbps-install >/dev/null 2>&1; then fix="sudo xbps-install -Sy git python3 curl"
            else refuse "no apt-get, pacman or xbps-install -- a Debian-family, Arch or Void Linux in this version"; fi
            # the pinned engine is a glibc build: a musl libc (Void's second
            # flavour, its loader at /lib/ld-musl-*.so.1) has nothing to run
            # it; SPARK_LD_MUSL pins the pattern in tests
            for f in ${SPARK_LD_MUSL:-/lib/ld-musl-*.so.1}; do
                [ ! -e "$f" ] || refuse "musl libc: the pinned engine is a glibc build -- Void's glibc flavour runs spark"
            done
            case $(uname -m) in
                x86_64|aarch64) ;;
                *) notice "no engine download for $(uname -m) (SPARK_ENGINE_DIR names your own)" ;;
            esac
            ;;
        *) refuse "$os: Linux (Debian, Arch or Void family) or macOS only" ;;
    esac
    missing=''
    command -v git >/dev/null 2>&1 || missing="$missing git"
    # the release tag's signature is checked by ssh-keygen (openssh) -- only
    # when a tag is what we land on (SPARK_REF names a ref, unverified)
    [ -n "${SPARK_REF:-}" ] || command -v ssh-keygen >/dev/null 2>&1 || missing="$missing ssh-keygen"
    if ! command -v python3 >/dev/null 2>&1 \
       || ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
        missing="$missing python3>=3.9"
    fi
    if [ -n "$missing" ]; then
        [ "$os" != Darwin ] || fix="xcode-select --install"
        refuse "missing:$missing -- $fix, then run this again"
    fi
    # for bootstrap's brew row when it is there
    if [ "$os" = Darwin ]; then
        for d in /opt/homebrew/bin /usr/local/bin; do
            if [ -x "$d/brew" ]; then PATH="$d:$PATH"; export PATH; break; fi
        done
    fi

    if [ -x "$dir/bin/spark" ] && [ -d "$dir/.git" ]; then
        git -C "$dir" fetch -q --tags origin || refuse "git fetch --tags failed in $show -- git -C $show status says why"
        if git -C "$dir" symbolic-ref -q HEAD >/dev/null 2>&1; then
            git -C "$dir" pull -q --ff-only || refuse "git pull --ff-only failed in $show -- git -C $show status says why"
            printf 'ok     clone        %s is spark already: pulled\n' "$show"
        else
            cur=$(git -C "$dir" describe --tags --exact-match 2>/dev/null) || cur=""
            if [ -z "$(git -C "$dir" tag -l 'v[0-9]*')" ]; then
                printf 'ok     clone        %s is spark already: at %s\n' "$show" "${cur:-no tag}"
            else
                # an update: the clone's own allowed-signers, forward only
                pick "$dir" "$dir/allowed-signers" forward
                [ -z "$skipped" ] || printf '!      clone        skipped %s\n' "$skipped"
                [ -n "$found" ] || refuse "no signed release ahead of $show: refused -- it stays at ${cur:-an untagged commit}"
                if [ "$(git -C "$dir" rev-parse "$found^{commit}")" = "$(git -C "$dir" rev-parse HEAD)" ]; then
                    printf 'ok     clone        %s is spark already: at %s\n' "$show" "$found"
                else
                    git -C "$dir" checkout -q --detach "$found" || refuse "git checkout --detach $found failed in $show"
                    printf 'ok     clone        %s is spark already: moved to %s\n' "$show" "$found"
                fi
            fi
        fi
    elif [ -e "$dir" ] && [ -n "$(ls -A "$dir" 2>/dev/null)" ]; then
        refuse "$show exists and is not spark -- move it or set SPARK_HOME"
    else
        git clone -q "$url" "$dir" || refuse "git clone failed -- is $url reachable?"
        if [ -n "$ref" ]; then
            git -C "$dir" checkout -q "$ref" || refuse "git checkout $ref failed in $show"
            printf 'ok     clone        %s at %s\n' "$show" "$ref"
        elif [ -n "$(git -C "$dir" tag -l 'v[0-9]*')" ]; then
            # the key this file carries, never the clone's own file: the
            # clone came from the network a moment ago. SPARK_SIGNERS is a
            # test seam (tests/get_test.sh): a file read in place of it
            keys=$(mktemp)
            trap 'rm -f "$keys"' EXIT
            if [ -n "${SPARK_SIGNERS:-}" ]; then
                notice "SPARK_SIGNERS=$SPARK_SIGNERS -- a test seam: the release key comes from that file"
                cat "$SPARK_SIGNERS" > "$keys"
            else
                printf '%s\n' "$SIGNERS" > "$keys"
            fi
            pick "$dir" "$keys"
            rm -f "$keys"
            [ -z "$skipped" ] || printf '!      clone        skipped %s\n' "$skipped"
            # the clone this line made goes with the refusal: a second
            # run must not find it and run main as if it were a release
            [ -n "$found" ] || { rm -rf "$dir"; refuse "no tag signed by a known key: refused -- nothing installed"; }
            git -C "$dir" checkout -q --detach "$found" || refuse "git checkout --detach $found failed in $show"
            printf 'ok     clone        %s at %s\n' "$show" "$found"
        else
            printf 'ok     clone        %s\n' "$show"
        fi
    fi
    if [ "$clone_only" = 1 ]; then
        printf 'next: %s/bin/spark setup\n' "$show"
        exit 0
    fi
    # under `curl | sh` stdin is this script: the questions read the terminal
    if [ -t 1 ] && [ -c /dev/tty ] && (: < /dev/tty) 2>/dev/null; then
        exec "$dir/bin/spark" setup < /dev/tty
    fi
    exec "$dir/bin/spark" setup
}

main "$@"
