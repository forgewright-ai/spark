# The engine pin: one llama.cpp release, one tarball per OS/arch/build
# (the macOS ones carry Metal; on Linux the vulkan build is picked when a
# GPU is there). bootstrap.sh downloads and verifies it; lib/spark/
# facts.py names the flavour and its sha; engine.pinned_version() reads
# the version. An empty or missing sha means "not pinned yet": the
# engine step skips with a notice, never guesses.
# b11960 (2026-10-28, llama.cpp 0.8.0): each sha256 is the file as fetched
# from the release on 2026-10-29, its build attestation verified with
# `gh attestation verify FILE --repo ggml-org/llama.cpp`; the glibc floor
# is b10689's, 2.34 on x86_64 and 2.38 on aarch64, read from the libraries
LLAMA_VERSION=b11960
LLAMA_SHA_MACOS_ARM64=58e5a5e1d7c2bf66cedd9c29e0323f3e570660a70a1e2156d32eed08f4cc1e3c
LLAMA_SHA_MACOS_X64=d1e6c9ddcaed9a3b1bb8f3d946bdb3481c7b919357a4029dcb747762397f1da5
LLAMA_SHA_LINUX_X64=31cc3a6bc638ac6c48dc4b1b74888f1eaadf3d14227c1e5f67daf9a49541d97a
LLAMA_SHA_LINUX_VULKAN_X64=164199e978304bb32a8a6c24b8efa015528ddf286821596eab676c90b375feac
LLAMA_SHA_LINUX_ARM64=0065ecfbffe8a790bb0d28059a3320cdc8f723b7f3f248cdc8bfc04790927715
LLAMA_SHA_LINUX_VULKAN_ARM64=22d1f852055a95a5c969b90326a2b68b4618eca6c54638bae27b4ee603031d53
