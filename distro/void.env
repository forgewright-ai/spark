# void -- Void Linux, the glibc flavour (ID=void; nothing says ID_LIKE=void).
# The same six keys as debian.env (contract 3). xbps is asked with -S (sync
# the index) and -y. A rolling distro: xbps itself must be current, so an
# install it refuses is a todo naming `sudo xbps-install -Su`. Every name
# here is credited in CREDITS.md.
PM=xbps
PM_INSTALL=sudo xbps-install -Sy
PM_TARGET=Void Linux
# core -- the AI (+ PKG_AI for vulkan); kbd is setvtrgb and setfont, the console's
PKG_CORE=git curl ca-certificates python3 kbd
# llama.cpp's build needs OpenMP: Void's libgomp is its own package
PKG_ENGINE=libgomp
# the vulkan build only: the loader and Mesa's two drivers
PKG_AI=vulkan-loader mesa-vulkan-radeon mesa-vulkan-intel
