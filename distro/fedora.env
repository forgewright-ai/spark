# fedora -- Fedora, and what says ID_LIKE=fedora (RHEL, Rocky, AlmaLinux,
# CentOS Stream: by family, not proven). The same six keys as debian.env
# (contract 3). dnf is asked with -y; a name counts as installed when
# any installed package provides it (rpm -q --whatprovides). A versioned
# release, never rolling: dnf refreshes its own index, so an install it
# refuses is a todo naming `sudo dnf upgrade --refresh`. Every name here
# is credited in CREDITS.md.
PM=dnf
PM_INSTALL=sudo dnf install -y
PM_TARGET=Fedora
# core -- the AI (+ PKG_AI for vulkan)
PKG_CORE=git curl ca-certificates python3
# llama.cpp's build needs OpenMP: Fedora's libgomp is gcc's own subpackage
PKG_ENGINE=libgomp
# the vulkan build only: the loader, and Mesa's drivers in one package
# (as Debian's mesa-vulkan-drivers)
PKG_AI=vulkan-loader mesa-vulkan-drivers
