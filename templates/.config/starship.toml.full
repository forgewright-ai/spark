# rendered by spark install.sh (SITE_PROMPT_STYLE=full) -- edit site.env or the template
# The blank line above the prompt is where spark prints its hint; keep it.
add_newline = true
format = "$username$hostname$directory$git_branch$git_status$python$nodejs$rust$golang$cmd_duration$line_break$time$character"

[username]
format = "[$user]($style)@"
style_user = "@THEME_MUTED@"
show_always = true

[hostname]
format = "[$hostname]($style) "
style = "@THEME_MUTED@"
ssh_only = false

[directory]
style = "bold @THEME_ACCENT@"
truncation_length = 4
truncate_to_repo = true

[git_branch]
format = "[$branch]($style) "
style = "@THEME_ANSI_5@"

[git_status]
format = "[$all_status$ahead_behind]($style) "
style = "@THEME_ANSI_3@"

[python]
format = "[py $version]($style) "
style = "@THEME_ANSI_6@"

[nodejs]
format = "[node $version]($style) "
style = "@THEME_ANSI_6@"

[rust]
format = "[rs $version]($style) "
style = "@THEME_ANSI_6@"

[golang]
format = "[go $version]($style) "
style = "@THEME_ANSI_6@"

[cmd_duration]
min_time = 2000
format = "[$duration]($style) "
style = "@THEME_ANSI_3@"

[time]
disabled = false
format = "[$time]($style) "
style = "@THEME_MUTED@"
time_format = "%H:%M"

[character]
success_symbol = "[>](@THEME_ANSI_2@)"
error_symbol = "[>](@THEME_ANSI_1@)"
