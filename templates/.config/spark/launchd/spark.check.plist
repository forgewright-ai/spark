<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- rendered by spark install.sh; installed into ~/Library/LaunchAgents by
     bootstrap.sh. Runs `spark check` every five minutes so the status line
     always has a fresh verdict to show. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>spark.check</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.local/bin/spark</string>
		<string>check</string>
		<string>--porcelain</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>PATH</key>
		<string>@HOME@/.local/bin:@BREW_PREFIX@/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<!-- the timer's own run (check.TIMER_ENV): only it refreshes the
		     knowledge index; a check typed by hand or over ssh only reports -->
		<key>SPARK_CHECK_TIMER</key>
		<string>1</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/.local/state/spark/check.log</string>
</dict>
</plist>
