#!/bin/sh
# rendered by spark install.sh -- the page's server for this LAN (runit).
# Enabled by bootstrap.sh (no `down` file) when SPARK_FORGE=on, or auto
# and the model server is enabled too; `spark forge off` puts the `down`
# file back. 78 = EX_CONFIG: not a crash.
export HOME=@HOME@ USER=@USER@ PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
exec 2>&1
exec @HOME@/.local/bin/spark forge --foreground
