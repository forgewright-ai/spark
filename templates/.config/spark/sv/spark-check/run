#!/bin/sh
# rendered by spark install.sh -- spark check every five minutes (runit
# has no timer), so the status line always has a fresh verdict
export HOME=@HOME@ USER=@USER@ PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
# the timer's own run (check.TIMER_ENV): only it refreshes the knowledge
# index; a check typed by hand or over ssh only reports
export SPARK_CHECK_TIMER=1
exec 2>&1
trap 'kill $! 2>/dev/null; exit 0' TERM INT
sleep 120 & wait $!
while :; do
    # the rows go nowhere (check.json keeps them); stderr stays on the
    # log pipe, so a check that cannot run says why in svlogd's tail.
    # stdin is /dev/null: runsv hands its own down, and that may be the
    # console, a terminal -- and a check at a terminal is a person's run
    # (check.unattended), which never refreshes the knowledge index
    @HOME@/.local/bin/spark check --porcelain </dev/null >/dev/null
    sleep 300 & wait $!
done
